// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  // output   = "../app/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Company {
  id              String            @id @default(cuid())
  name            String
  address         String?
  phone           String?
  email           String?
  users           User[]
  isActive        Boolean           @default(true)
  isDeleted       Boolean           @default(false)
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime?
  createBy        String?
  updateBy        String?
  role            Role[]
  rolePermisions  RolePermision[]
  auditlog        auditlog[]
  lang            Lang[]
  menu            Menu[]
  menuType        MenuType[]
  menuTranslation MenuTranslation[]
  mediaPage       MediaPage[]
  page            Page[]
  pageCategory    PageCategory[]
  pageTranslation PageTranslation[]
  wordingPage     WordingPage[]
  wordingGeneral  WordingGeneral[]
  settingApp      SettingApp[]
  category        Category[]
  template        Template[]
  section         Section[]
  media           Media[]
  getInTouch      GetInTouch[]

  @@map("Company")
}

model User {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  password   String
  name       String
  companyId  String?
  company    Company?  @relation(fields: [companyId], references: [id])
  roleId     Int
  role       Role      @relation(fields: [roleId], references: [id])
  token      String?   @db.Text // opsional, bisa untuk menyimpan token
  tokenAt    DateTime? @default(now())
  updateAt   DateTime  @default(now())
  createdAt  DateTime  @default(now())
  isActive   Boolean   @default(true)
  isDeleted  Boolean   @default(false)
  isLogin    Boolean   @default(false)
  loginDate  DateTime?
  logOutDate DateTime?
  deletedAt  DateTime?
  createBy   String?
  updateBy   String?
  lang       Lang?     @relation(fields: [langCode], references: [code])
  langCode   String?

  @@map("User")
}

model Role {
  id           Int             @id @default(autoincrement())
  name         String          @unique
  companyId    String?
  company      Company?        @relation(fields: [companyId], references: [id])
  users        User[]
  permisions   RolePermision[]
  isActive     Boolean         @default(true)
  isSuperAdmin Boolean         @default(false)
  isDeleted    Boolean         @default(false)
  deletedAt    DateTime?
  updateAt     DateTime        @default(now())
  createdAt    DateTime        @default(now())
  createBy     String?
  updateBy     String?

  @@map("Role")
}

model RolePermision {
  id        Int       @id @default(autoincrement())
  companyId String?
  company   Company?  @relation(fields: [companyId], references: [id])
  roleId    Int
  role      Role      @relation(fields: [roleId], references: [id])
  menuId    Int
  menu      Menu      @relation(fields: [menuId], references: [id])
  view      Boolean   @default(false)
  create    Boolean   @default(true)
  update    Boolean   @default(false)
  deleted   Boolean   @default(false)
  approval  Boolean   @default(false)
  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  updateAt  DateTime  @default(now())
  createdAt DateTime  @default(now())
  createBy  String?
  updateBy  String?

  @@map("RolePermision")
}

model auditlog {
  id        Int      @id @default(autoincrement())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  userId    Int
  user      String
  ip        String
  urlApi    String
  urlFe     String
  methodApi String
  bodyApi   String   @db.LongText
  menuId    Int
  menuLabel String
  pageId    Int
  PageLabel String
  createBy  String
  updateBy  String
  updateAt  DateTime @default(now())
  createdAt DateTime @default(now())
}

model Lang {
  code             String            @id
  name             String
  companyId        String?
  company          Company?          @relation(fields: [companyId], references: [id])
  isActive         Boolean           @default(true)
  isDeleted        Boolean           @default(false)
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createBy         String?
  updateBy         String?
  menuTranslations MenuTranslation[]
  pageTranslations PageTranslation[]
  sections         Section[]
  pageCategory     PageCategory[]
  wording          WordingPage[]
  user             User[]

  @@map("Lang")
}

model Media {
  id        Int       @id @default(autoincrement())
  companyId String?
  company   Company?  @relation(fields: [companyId], references: [id])
  menuId    Int
  type      String
  langCode  String
  url       String // URL bisa beda per bahasa
  alt       String?
  title     String?
  menu      Menu      @relation(fields: [menuId], references: [id])
  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createBy  String?
  updateBy  String?

  @@unique([menuId, type, langCode])
  @@map("Media")
}

model Menu {
  id             Int                @id @default(autoincrement())
  companyId      String?
  company        Company?           @relation(fields: [companyId], references: [id])
  parentId       Int?
  parent         Menu?              @relation("MenuToSub", fields: [parentId], references: [id])
  children       Menu[]             @relation("MenuToSub")
  order          Int                @default(0)
  isActive       Boolean            @default(true)
  sort           Int                @default(0)
  publishAt      DateTime?          @default(now())
  unPublishAt    DateTime?
  approvalStatus PageApprovalStatus @default(APPROVED)
  approvalNote   String?            @db.Text
  approvalDraft  Json?
  requestedAt    DateTime?
  requestedBy    String?
  approvedAt     DateTime?
  approvedBy     String?
  rejectedAt     DateTime?
  rejectedBy     String?
  medias         Media[]
  typeMenuId     Int?
  typeMenu       MenuType?          @relation(fields: [typeMenuId], references: [id])
  isDeleted      Boolean            @default(false)
  deletedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime?
  createBy       String?
  updateBy       String?
  translations   MenuTranslation[]
  rolePermisions RolePermision[]

  @@map("Menu")
}

model MenuType {
  id        Int       @id @default(autoincrement())
  companyId String?
  company   Company?  @relation(fields: [companyId], references: [id])
  name      String
  slug      String?
  menus     Menu[]
  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  updateAt  DateTime  @default(now())
  createdAt DateTime  @default(now())
  createBy  String?
  updateBy  String?

  @@map("MenuType")
}

model GetInTouch {
  id        Int      @id @default(autoincrement())
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  name      String
  phone     String
  email     String
  location  String
  messages  String   @db.Text
  ip        String
  createdAt DateTime @default(now())
  createBy  String?

  @@map("GetInTouch")
}

model MenuTranslation {
  id          Int       @id @default(autoincrement())
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id])
  menuId      Int
  langCode    String
  title       String
  subTitle    String?
  linkType    LinkType? @default(URL)
  slug        String?
  pageId      Int?
  categoryId  Int?
  description String?   @db.Text
  overview    String?   @db.Text
  category    Category? @relation(fields: [categoryId], references: [id])
  page        Page?     @relation(fields: [pageId], references: [id])
  menu        Menu      @relation(fields: [menuId], references: [id])
  lang        Lang      @relation(fields: [langCode], references: [code])
  isActive    Boolean   @default(true)
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime?
  createBy    String?
  updateBy    String?

  @@unique([menuId, langCode])
  @@map("MenuTranslation")
}

enum PageType {
  POST
  PAGE
}

enum PageApprovalStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum LinkType {
  URL
  PAGE
  CATEGORY
}

model MediaPage {
  id         Int       @id @default(autoincrement())
  companyId  String?
  company    Company?  @relation(fields: [companyId], references: [id])
  pageId     Int?
  categoryId Int?
  type       String
  langCode   String
  url        String    @db.VarChar(500)
  alt        String?
  title      String?
  menu       Page?     @relation(fields: [pageId], references: [id])
  category   Category? @relation(fields: [categoryId], references: [id])
  isActive   Boolean   @default(true)
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  createBy   String?
  updateBy   String?

  @@unique([pageId, type, langCode])
  @@map("MediaPage")
}

model Page {
  id               Int                @id @default(autoincrement())
  companyId        String?
  company          Company?           @relation(fields: [companyId], references: [id])
  pageType         PageType           @default(PAGE)
  order            Int                @default(0)
  sort             Int                @default(0)
  publishAt        DateTime?          @default(now())
  unPublishAt      DateTime?
  approvalStatus   PageApprovalStatus @default(APPROVED)
  approvalNote     String?            @db.Text
  approvalDraft    Json?
  requestedAt      DateTime?
  requestedBy      String?
  approvedAt       DateTime?
  approvedBy       String?
  rejectedAt       DateTime?
  rejectedBy       String?
  mediaPages       MediaPage[]
  isActive         Boolean            @default(true)
  isDeleted        Boolean            @default(false)
  deletedAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime?
  createBy         String?
  updateBy         String?
  count            Int                @default(0)
  translations     PageTranslation[]
  menuTranslations MenuTranslation[]
  sectionsAsMain   Section[]          @relation("PageAsMain")
  sectionsAsData   Section[]          @relation("PageAsData")
  pageCategories   PageCategory[]
  wording          WordingPage[]

  @@map("Page")
}

model PageCategory {
  id         Int       @id @default(autoincrement())
  companyId  String?
  company    Company?  @relation(fields: [companyId], references: [id])
  pageId     Int
  page       Page?     @relation(fields: [pageId], references: [id])
  categoryId Int?
  categories Category? @relation(fields: [categoryId], references: [id])
  langCode   String?
  lang       Lang?     @relation(fields: [langCode], references: [code])

  @@map("PageCategory")
}

model PageTranslation {
  id                 Int       @id @default(autoincrement())
  companyId          String?
  company            Company?  @relation(fields: [companyId], references: [id])
  pageId             Int?
  categoryId         Int?
  view               Int       @default(0)
  langCode           String
  title              String
  subTitle           String?
  slug               String?
  description        String?   @db.Text
  overview           String?   @db.Text
  metaTitle          String? // Title untuk tag <title>
  metaDescription    String? // Untuk tag <meta name="description">
  metaKeywords       String? // Untuk tag <meta name="keywords"> (meskipun jarang digunakan)
  ogTitle            String? // Untuk tag <meta property="og:title">
  ogDescription      String? // Untuk tag <meta property="og:description">
  ogImage            String? // Untuk tag <meta property="og:image">
  ogType             String? // Untuk tag <meta property="og:type">
  canonicalUrl       String? // Untuk tag <link rel="canonical">
  robots             String? // Untuk konfigurasi index/follow per halaman
  twitterCard        String? // Untuk tag twitter:card
  twitterTitle       String? // Untuk tag twitter:title
  twitterDescription String?   @db.Text // Untuk tag twitter:description
  twitterImage       String? // Untuk tag twitter:image
  structuredData     String?   @db.Text // JSON-LD per halaman
  page               Page?     @relation(fields: [pageId], references: [id])
  category           Category? @relation(fields: [categoryId], references: [id])
  lang               Lang      @relation(fields: [langCode], references: [code])
  isActive           Boolean   @default(true)
  isDeleted          Boolean   @default(false)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime?
  createBy           String?
  updateBy           String?

  @@unique([pageId, langCode])
  @@map("PageTranslation")
}

model WordingPage {
  companyId        String?
  company          Company?        @relation(fields: [companyId], references: [id])
  id               Int             @id @default(autoincrement())
  wordingGeneralId Int?
  wordingGeneral   WordingGeneral? @relation(fields: [wordingGeneralId], references: [id])
  key              String
  label            String          @db.Text
  langCode         String
  lang             Lang            @relation(fields: [langCode], references: [code])
  page             Page?           @relation(fields: [pageId], references: [id])
  pageId           Int?
  isActive         Boolean         @default(true)
  isDeleted        Boolean         @default(false)
  deletedAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime?
  createBy         String?
  updateBy         String?

  @@map("WordingPage")
}

model WordingGeneral {
  companyId   String?
  company     Company?      @relation(fields: [companyId], references: [id])
  id          Int           @id @default(autoincrement())
  key         String
  isActive    Boolean       @default(true)
  isDeleted   Boolean       @default(false)
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime?
  createBy    String?
  updateBy    String?
  WordingPage WordingPage[]

  @@map("WordingGeneral")
}

model SettingApp {
  id        Int       @id @default(autoincrement())
  companyId String?
  company   Company?  @relation(fields: [companyId], references: [id])
  key       String
  value     String?
  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime?
  createBy  String?
  updateBy  String?

  @@map("SettingApp")
}

model Category {
  id               Int               @id @default(autoincrement())
  companyId        String?
  company          Company?          @relation(fields: [companyId], references: [id])
  pageTranslations PageTranslation[]
  medias           MediaPage[]
  sections         Section[]
  isActive         Boolean           @default(true)
  isDeleted        Boolean           @default(false)
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime?
  createBy         String?
  updateBy         String?
  menuTranslations MenuTranslation[]
  pageCategories   PageCategory[]

  @@map("Category")
}

model Template {
  id        Int       @id @default(autoincrement())
  companyId String?
  company   Company?  @relation(fields: [companyId], references: [id])
  name      String
  code      String
  sections  Section[]
  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime?
  createBy  String?
  updateBy  String?

  @@map("Template")
}

enum SectionType {
  CONTENT
  CATEGORY
  PAGE
}

model Section {
  id             Int             @id @default(autoincrement())
  companyId      String?
  company        Company?        @relation(fields: [companyId], references: [id])
  type           SectionType
  order          Int             @default(0)
  pageId         Int?
  page           Page?           @relation("PageAsMain", fields: [pageId], references: [id])
  pageIdData     Int?
  pageData       Page?           @relation("PageAsData", fields: [pageIdData], references: [id])
  categoryId     Int?
  category       Category?       @relation(fields: [categoryId], references: [id])
  templateId     Int?
  template       Template?       @relation(fields: [templateId], references: [id])
  langCode       String
  lang           Lang            @relation(fields: [langCode], references: [code])
  title          String?
  subTitle       String?
  image          String?
  secondImage    String?
  slug           String?
  description    String?         @db.Text
  overview       String?         @db.Text
  customConfig   Json?
  isActive       Boolean         @default(true)
  isDeleted      Boolean         @default(false)
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime?
  createBy       String?
  updateBy       String?
  pageShortLinks PageShortLink[]

  @@map("Section")
}

model PageShortLink {
  id        Int       @id @default(autoincrement())
  sectionId Int
  section   Section   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  link      String    @db.VarChar(500)
  count     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime?
  createBy  String?
  updateBy  String?

  @@map("PageShortLink")
}
